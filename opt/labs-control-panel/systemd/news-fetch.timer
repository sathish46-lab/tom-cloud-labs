[Unit]
Description=Tom Labs News Fetcher Timer - Check news auto-fetch schedule
Requires=news-fetch.service

[Timer]
# Check every 1 minute
OnCalendar=*:0/1:00
# Also run 5 minutes after boot
OnBootSec=5min
# Run now if the timer was missed while the system was off
Persistent=true

[Install]
WantedBy=timers.target
