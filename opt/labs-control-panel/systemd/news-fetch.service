[Unit]
Description=Tom Labs News Fetcher - Auto-fetch cybersecurity news
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/labs/htdocs
ExecStart=/usr/bin/php /var/www/labs/htdocs/app/news/fetch.php
Environment=PHP_VALUE="auto_prepend_file=/var/www/labs/htdocs/src/load.php"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target