# =============================================================================
# Labs Docker Compose Environment — SAMPLE
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#   cp .env.sample .env
#
# NEVER commit real secrets to version control. This file is safe to commit.
# =============================================================================

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASS=CHANGE_ME_MONGO_PASSWORD
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
DATABASE_FILE=mongodb://admin:CHANGE_ME_MONGO_PASSWORD@127.0.0.1:27017/tom_labs_db?authSource=admin

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# --- MariaDB (split service container; required by compose) ---
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT_PASSWORD

# --- API ---
API_SECRET=CHANGE_ME_API_SECRET
AI_INTERNAL_TOKEN=CHANGE_ME_AI_INTERNAL_TOKEN
AI_API_KEY=CHANGE_ME_AI_API_KEY

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=contact@tomweb.in

# --- S3 ---
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY

# --- Google OAuth ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# --- GitLab OAuth ---
GITLAB_CLIENT_ID=CHANGE_ME_GITLAB_CLIENT_ID
GITLAB_CLIENT_SECRET=CHANGE_ME_GITLAB_CLIENT_SECRET

# --- WireGuard ---
WIREGUARD_PUBLIC_KEY=CHANGE_ME_WIREGUARD_PUBLIC_KEY

# --- Compose port mapping overrides ---
# Dev stack uses 9xxx to avoid clashing with prod on 80/443 when both run locally.
HTTP_PORT=9080
HTTPS_PORT=9443
MQS_PORT=9081
MQS_MGMT_PORT=9082
RABBIT_PORT=5673
RABBIT_MGMT_PORT=15673
RABBIT_MGMT_EXTRA_PORT=15674
WG_PORT=51821
SSH_PORT=2222

# --- Container / network names ---
VPS_CONTAINER=Dev_lab
BACKEND_NET=dev_backend
BACKEND_SUBNET=10.20.144.0/20
BACKEND_GATEWAY=10.20.144.1

# --- Work / news domains ---
# Dev enables them; prod sets empty via its own .env.
WORK_DOMAIN=work.dev.tomweb.in
NEWS_DOMAIN=news.dev.tomweb.in

# --- SSL / contact ---
SSL_EMAIL=admin@example.com
CONTACT_ADMIN_EMAIL=contact@tomweb.in

# --- Cloudflare Tunnel (prod only) ---
# Set these in your prod `.env` (never commit real tokens):
TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN
CF_API_KEY=CHANGE_ME_CLOUDFLARE_API_KEY
DDNS_ZONE=tomweb.in
DDNS_SUBDOMAIN=vpn
DDNS_PROXIED=false
